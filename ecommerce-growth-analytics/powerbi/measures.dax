// Table name must be DashboardData. Import RowType as text and metrics as numeric.
// Measures deliberately select the correct grain; never sum all mixed RowTypes.
Total Sessions = CALCULATE(SUM(DashboardData[Sessions]), DashboardData[RowType] = "Overview")
Observed Users = CALCULATE(SUM(DashboardData[Users]), DashboardData[RowType] = "Overview")
Purchasing Sessions = CALCULATE(SUM(DashboardData[PurchasingSessions]), DashboardData[RowType] = "Overview")
Overall Session Purchase Rate = DIVIDE([Purchasing Sessions], [Total Sessions])
Daily Sessions = CALCULATE(SUM(DashboardData[Sessions]), DashboardData[RowType] = "Daily")
Daily Purchasing Sessions = CALCULATE(SUM(DashboardData[PurchasingSessions]), DashboardData[RowType] = "Daily")
Daily Purchase Rate = DIVIDE([Daily Purchasing Sessions], [Daily Sessions])
Acquisition Purchase Rate = DIVIDE(CALCULATE(SUM(DashboardData[PurchasingSessions]), DashboardData[RowType] = "Acquisition"), CALCULATE(SUM(DashboardData[Sessions]), DashboardData[RowType] = "Acquisition"))
Device Ordered Purchase Rate = DIVIDE(CALCULATE(SUM(DashboardData[OrderedPurchases]), DashboardData[RowType] = "Device"), CALCULATE(SUM(DashboardData[ViewSessions]), DashboardData[RowType] = "Device"))
Cohort Retention Rate = DIVIDE(SUM(DashboardData[ActiveUsers]), SUM(DashboardData[CohortUsers]))
// Cohort Retention Rate: apply RowType=Cohort and a single WeekNumber or matrix cells.
// Do not sum users across daily/source/segment rows or cohort sizes across weeks.
